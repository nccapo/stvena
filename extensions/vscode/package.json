{
  "name": "stvena-live",
  "displayName": "Stvena Live",
  "description": "Accept or reject agent changes in your editor, and follow agent reads and edits with live source navigation.",
  "version": "0.4.1",
  "icon": "media/icon.png",
  "publisher": "nccapo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nccapo/stvena.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/nccapo/stvena/blob/${STVENA_SOURCE_REF:-main}/extensions/vscode --baseImagesUrl https://raw.githubusercontent.com/nccapo/stvena/${STVENA_SOURCE_REF:-main}/extensions/vscode"
  },
  "contributes": {
    "commands": [
      {
        "command": "stvena.toggleFollow",
        "title": "Stvena: Pause / Resume Following",
        "icon": "$(debug-pause)"
      },
      {
        "command": "stvena.showLatest",
        "title": "Stvena: Show Latest Activity",
        "icon": "$(go-to-file)"
      },
      {
        "command": "stvena.openChange",
        "title": "Stvena: Open Captured Edit"
      },
      {
        "command": "stvena.reviewInStvena",
        "title": "Stvena: Review This Line in Stvena"
      },
      {
        "command": "stvena.addSelectionToContext",
        "title": "Stvena: Add Selection to Context"
      },
      {
        "command": "stvena.acceptHunk",
        "title": "Stvena: Accept Change"
      },
      {
        "command": "stvena.unacceptHunk",
        "title": "Stvena: Undo Accept"
      },
      {
        "command": "stvena.rejectHunk",
        "title": "Stvena: Reject Change"
      },
      {
        "command": "stvena.rejectHunkWithReason",
        "title": "Stvena: Reject Change with Reason…"
      },
      {
        "command": "stvena.undoRejectHunk",
        "title": "Stvena: Undo Reject"
      },
      {
        "command": "stvena.acceptFile",
        "title": "Stvena: Accept All Changes in This File"
      },
      {
        "command": "stvena.rejectFile",
        "title": "Stvena: Reject All Changes in This File"
      },
      {
        "command": "stvena.applyRejections",
        "title": "Stvena: Apply Rejected Changes Now",
        "icon": "$(check-all)"
      },
      {
        "command": "stvena.askAgent",
        "title": "Stvena: Ask the Agent About This Selection"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "stvena.changes",
          "name": "Stvena Live"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stvena.changes",
        "contents": "Run **stvena** in this project's terminal. Reported reads and captured edits will appear here.\n[Show latest activity](command:stvena.showLatest)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stvena.toggleFollow",
          "when": "view == stvena.changes",
          "group": "navigation"
        },
        {
          "command": "stvena.showLatest",
          "when": "view == stvena.changes",
          "group": "navigation"
        },
        {
          "command": "stvena.applyRejections",
          "when": "view == stvena.changes",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "stvena.askAgent",
          "group": "stvena@0"
        },
        {
          "command": "stvena.reviewInStvena",
          "group": "stvena@1"
        },
        {
          "command": "stvena.addSelectionToContext",
          "group": "stvena@2"
        },
        {
          "command": "stvena.acceptFile",
          "group": "stvena@3"
        },
        {
          "command": "stvena.rejectFile",
          "group": "stvena@4"
        }
      ],
      "commandPalette": [
        {
          "command": "stvena.openChange",
          "when": "false"
        },
        {
          "command": "stvena.acceptHunk",
          "when": "false"
        },
        {
          "command": "stvena.unacceptHunk",
          "when": "false"
        },
        {
          "command": "stvena.rejectHunk",
          "when": "false"
        },
        {
          "command": "stvena.rejectHunkWithReason",
          "when": "false"
        },
        {
          "command": "stvena.undoRejectHunk",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "stvena.readBackground",
        "description": "Background of the latest agent read range.",
        "defaults": {
          "dark": "#3794ff20",
          "light": "#007acc18",
          "highContrast": "#3794ff30"
        }
      },
      {
        "id": "stvena.editBackground",
        "description": "Background of the latest captured edit range.",
        "defaults": {
          "dark": "#cca70020",
          "light": "#b8950018",
          "highContrast": "#cca70030"
        }
      },
      {
        "id": "stvena.reviewBackground",
        "description": "Background of the source range currently selected in Stvena review.",
        "defaults": {
          "dark": "#b180d720",
          "light": "#7c3aab18",
          "highContrast": "#b180d730"
        }
      },
      {
        "id": "stvena.reviewHunkBackground",
        "description": "Background of an agent change that has not been reviewed.",
        "defaults": {
          "dark": "#cca70014",
          "light": "#b8950010",
          "highContrast": "#cca70024"
        }
      },
      {
        "id": "stvena.reviewAcceptedBackground",
        "description": "Background of an accepted agent change.",
        "defaults": {
          "dark": "#89d18510",
          "light": "#3d8a3d0d",
          "highContrast": "#89d18520"
        }
      },
      {
        "id": "stvena.reviewRejectedBackground",
        "description": "Background of a rejected agent change.",
        "defaults": {
          "dark": "#f1707018",
          "light": "#c5303012",
          "highContrast": "#f1707028"
        }
      }
    ],
    "configuration": {
      "title": "Stvena Live",
      "properties": {
        "stvena.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Accept and Reject actions above each agent change block."
        }
      }
    },
    "keybindings": [
      {
        "command": "stvena.askAgent",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
